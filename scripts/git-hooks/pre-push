#!/usr/bin/env bash
# push 前置闸，两臂：
#   形状臂＝gitleaks：判这批待推提交的**新增行**里有没有凭据形状，判据来自仓根 .gitleaks.toml。
#   字节臂＝同目录 tfa-prepush-bytearm.py：拿本机 0600 值目录里的在册值，按字节比这批射程的
#            每一行（新增行与删除行都比）。它补的是形状臂看不见的那一格——"把口令从文档里删掉"
#            那一笔，值照样躺在删除行里进提交对象，形状臂一个字不报（2026-10-10 现量：
#            _shared 待推 10 笔，形状臂 0 条、字节臂 6 枚值名）。
#
# 为什么放在 scripts/git-hooks 而不是 .git/hooks：前者进版本库，换台机器 clone 之后
# 跑一条 `git config core.hooksPath scripts/git-hooks` 就装回来；后者是每台机器各自的暗配置。
#
# 失败即拦（fail-closed）：没有 gitleaks、没有字节臂脚本、没有 python3、字节臂一声没出
# （崩了）——都拦，并给装法。字节臂退出码 3 是"这一臂没跑成"，同样按拦处理，不许读成放行。
set -uo pipefail

GL="${GITLEAKS_BIN:-$(command -v gitleaks || true)}"
if [ -z "$GL" ]; then
  echo "✗ pre-push 闸不通过：本机找不到 gitleaks。" >&2
  echo "  装法: brew install gitleaks   或设 GITLEAKS_BIN=<可执行文件路径>" >&2
  exit 1
fi

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
BAR="$HOOK_DIR/tfa-prepush-bytearm.py"
PY="${PYTHON_BIN:-$(command -v python3 || true)}"
if [ ! -f "$BAR" ]; then
  echo "✗ pre-push 闸不通过：字节臂脚本不在 $BAR（闸只装了一半比不装更坏）。" >&2
  exit 1
fi
if [ -z "$PY" ]; then
  echo "✗ pre-push 闸不通过：本机没有 python3，字节臂发不动。" >&2
  exit 1
fi

ZERO="0000000000000000000000000000000000000000"
REPO_ROOT="$(git rev-parse --show-toplevel)"
CFG="$REPO_ROOT/.gitleaks.toml"
[ -f "$CFG" ] || { echo "✗ pre-push 闸不通过：缺判据文件 $CFG" >&2; exit 1; }

blocked=0
bar_blocked=0
scanned=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # 删远端分支：没东西要扫
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    # 新分支：只扫这条 ref 上还没在别处的提交
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  n=$(git rev-list --count $range 2>/dev/null || echo "?")
  echo "· 扫 $local_ref 待推提交（$n 笔）"
  scanned=$((scanned+1))
  # 形状臂：--log-opts 把范围交给 gitleaks，它按逐笔提交的 diff 判；--redact 保证日志里不出值
  if ! "$GL" git --config "$CFG" --log-opts="$range" --redact --exit-code 1 "$REPO_ROOT"; then
    blocked=$((blocked+1))
  fi
  # 字节臂：值只从 0600 目录读进内存，输出里只有值名与计数
  bout="$("$PY" "$BAR" "$REPO_ROOT" "$range" 2>&1)"
  brc=$?
  printf '%s\n' "$bout" | sed 's/^/   /'
  case "$brc" in
    0) : ;;
    1) bar_blocked=$((bar_blocked+1)) ;;
    *) echo "   ✗ 字节臂退 $brc＝这一臂没跑成（射程坏/解析坏/值目录空），按拦处理" >&2
       bar_blocked=$((bar_blocked+1)) ;;
  esac
  if ! printf '%s\n' "$bout" | grep -q '字节臂'; then
    echo "   ✗ 字节臂一声没出（rc=$brc）⇒ 当作没跑，按拦处理" >&2
    bar_blocked=$((bar_blocked+1))
  fi
done

if [ "$scanned" -eq 0 ]; then
  echo "· pre-push 闸：没有新提交要扫，放行"
  exit 0
fi
if [ "$blocked" -gt 0 ]; then
  echo "✗ pre-push 闸（形状臂）拦下 $blocked 条 ref：这批待推提交里有凭据形状的内容。" >&2
  echo "  处理：把值从要提交的行里拿掉（改成指向运行时取用处的说明），不要用 --no-verify 绕过。" >&2
  echo "  若这一格是模板占位被误判，往 .gitleaks.toml 的 allowlists 加一条带文件与理由的形状，别加整目录豁免。" >&2
  exit 1
fi
if [ "$bar_blocked" -gt 0 ]; then
  echo "✗ pre-push 闸（字节臂）拦下 $bar_blocked 条 ref：在册值会随这批提交第一次上公开面，或这一臂没跑成。" >&2
  echo "  正当出路只有三条：把这枚值轮掉（换完在值目录里改名成 *.retired-*，臂自动放行）；" >&2
  echo "  或先改写历史再推；或把值目录装齐让这一臂能跑。--no-verify 等于亲手交出处女副本，别用。" >&2
  exit 1
fi
echo "✓ pre-push 闸：$scanned 条 ref 两臂都过（形状臂无新增凭据形状、字节臂无首次公开的在册值）"
