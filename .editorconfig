# EditorConfig 配置
# 帮助开发者在不同编辑器和 IDE 之间保持一致的编码风格

# 表示这是最顶层的配置文件
root = true

# 对所有文件生效
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown 文件保留尾随空格（用于换行）
[*.md]
trim_trailing_whitespace = false

# JSON 文件
[*.json]
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_size = 2

# Makefile 必须使用 tab
[Makefile]
indent_style = tab

# Python 文件使用 4 空格缩进
[*.py]
indent_size = 4

# Go 文件使用 tab
[*.go]
indent_style = tab
