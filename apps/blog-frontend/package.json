{
  "name": "blog-frontend",
  "version": "1.0.0",
  "description": "博客前台 - Blog Frontend (Nuxt 3 SSR)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NUXT_PUBLIC_ENV=dev PORT=3004 nuxt dev",
    "build": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 NUXT_PUBLIC_ENV=pro nuxt build",
    "preview": "cross-env NUXT_PUBLIC_ENV=pro PORT=3001 node .output/server/index.mjs",
    "serve:dev": "cross-env NUXT_PUBLIC_ENV=dev PORT=3004 nuxt dev",
    "serve:local": "cross-env NUXT_PUBLIC_ENV=local PORT=3008 nuxt dev",
    "serve:beta": "cross-env NUXT_PUBLIC_ENV=beta nuxt dev",
    "serve:pro": "cross-env NUXT_PUBLIC_ENV=pro PORT=3001 node .output/server/index.mjs",
    "build:beta": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 NUXT_PUBLIC_ENV=beta nuxt build",
    "build:pro": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 NUXT_PUBLIC_ENV=pro nuxt build",
    "start": "cross-env NUXT_PUBLIC_ENV=pro PORT=3001 node .output/server/index.mjs",
    "start:pro": "cross-env NUXT_PUBLIC_ENV=pro PORT=3001 node .output/server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "clean": "rm -rf .nuxt .output dist"
  },
  "dependencies": {
    "@ant-design-vue/nuxt": "^1.4.2",
    "@nuxtjs/robots": "^5.5.5",
    "@nuxtjs/sitemap": "^7.4.7",
    "@nuxtjs/tailwindcss": "^6.12.1",
    "@pinia/nuxt": "^0.5.1",
    "@vavt/v3-extension": "^1.2.4",
    "@vueuse/motion": "^2.2.6",
    "@xld/design-tokens": "workspace:*",
    "@xld/shared-utils": "workspace:*",
    "md-editor-v3": "^4.21.3",
    "node-fetch": "^2.7.0",
    "nuxt": "^3.12.3",
    "pinia": "^2.1.7",
    "pinia-plugin-persist": "^1.0.0",
    "tslib": "^2.8.1",
    "vue": "latest"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "sass": "^1.77.8",
    "sass-loader": "^14.2.1"
  },
  "license": "MIT"
}
