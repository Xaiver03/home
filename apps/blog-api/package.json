{
  "name": "blog-api",
  "version": "1.0.0",
  "description": "博客后端 API - Blog Backend API (Express + MySQL + Redis)",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=dev nodemon ./bin/www",
    "start": "cross-env NODE_ENV=pro node ./bin/www",
    "serve:dev": "cross-env NODE_ENV=dev nodemon ./bin/www",
    "serve:local": "cross-env NODE_ENV=local nodemon ./bin/www",
    "serve:beta": "cross-env NODE_ENV=beta nodemon ./bin/www",
    "serve:pro": "cross-env NODE_ENV=pro nodemon ./bin/www",
    "build": "echo 'Blog API does not require build'",
    "clean": "rm -rf logs/*.log",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:bootstrap:company": "cross-env NODE_ENV=dev node scripts/bootstrapCompanyContent.js",
    "db:bootstrap:company:production": "cross-env NODE_ENV=pro node scripts/bootstrapCompanyContent.js --production",
    "storage:migrate-local": "node scripts/migrateLocalStorageToMinio.js",
    "storage:upload-avatar": "node scripts/uploadProfileAvatar.js",
    "migration:generate": "sequelize-cli migration:generate --name"
  },
  "dependencies": {
    "@xld/shared-utils": "workspace:*",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "config": "^3.3.11",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "express": "~4.16.1",
    "express-async-errors": "^3.1.1",
    "express-jwt": "^8.4.1",
    "formidable": "^3.5.1",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "morgan": "~1.9.1",
    "mysql2": "^3.10.1",
    "nodemailer": "^6.9.15",
    "pg": "^8.22.0",
    "redis": "^4.7.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.5"
  }
}
