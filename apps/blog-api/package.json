{
  "name": "blog-api",
  "version": "1.0.0",
  "description": "博客后端 API - Blog Backend API (Express + MySQL + Redis)",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=dev nodemon ./bin/www",
    "start": "cross-env NODE_ENV=pro node ./bin/www",
    "serve:dev": "cross-env NODE_ENV=dev nodemon ./bin/www",
    "serve:beta": "cross-env NODE_ENV=beta nodemon ./bin/www",
    "serve:pro": "cross-env NODE_ENV=pro nodemon ./bin/www",
    "build": "echo 'Blog API does not require build'",
    "clean": "rm -rf logs/*.log",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "migration:generate": "sequelize-cli migration:generate --name"
  },
  "dependencies": {
    "@xld/shared-utils": "workspace:*",
    "ali-oss": "^6.20.0",
    "config": "^3.3.11",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "express": "~4.16.1",
    "express-async-errors": "^3.1.1",
    "express-jwt": "^8.4.1",
    "formidable": "^3.5.1",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.9.1",
    "mysql2": "^3.10.1",
    "nodemailer": "^6.9.15",
    "qiniu": "^7.14.0",
    "redis": "^4.7.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bokey76/space-log-express.git"
  }
}
